---
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  slug?: string;
  title?: string;
  text?: string;
}
const {
  slug = 'funfest-crowd-reaching',
  title = 'Someone is waiting for 26th December.',
  text = 'Your gift, big or small, becomes a meal, a school bag or a warm outfit placed straight into someone’s hands.',
} = Astro.props;
---

<section class="cta">
  <Photo slug={slug} lightbox={false} class="cta__bg" sizes="100vw" widths={[640, 1000, 1600]} alt="" />
  <div class="wrap cta__in">
    <h2 class="reveal">{title}</h2>
    <p class="reveal" style="--d:1">{text}</p>
    <div class="cta__btns reveal" style="--d:2">
      <a href="/donate#give" class="btn btn--sun"><Icon name="heart" /> Give now</a>
      <a href="/get-involved#volunteer" class="btn btn--ghost">Volunteer with us</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: #fff;
    padding-block: clamp(5rem, 4rem + 8vw, 10rem);
    overflow: hidden;
  }
  .cta :global(.cta__bg) {
    position: absolute;
    inset: 0;
    border-radius: 0;
    z-index: -2;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 0% 100%, rgba(242, 106, 27, 0.75), transparent 60%),
      linear-gradient(180deg, rgba(23, 24, 58, 0.55), rgba(23, 24, 58, 0.88));
  }
  .cta__in {
    max-width: 820px;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(2.3rem, 1.5rem + 4vw, 4.6rem);
  }
  .cta p {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    max-width: 40ch;
    margin: 0 auto 2rem;
    opacity: 0.92;
  }
  .cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
  }
  @media (max-width: 520px) {
    .cta__btns .btn {
      width: 100%;
    }
  }
</style>
