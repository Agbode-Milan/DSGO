---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size, class: cls } = Astro.props;

// UI icons: Phosphor "fill" set (MIT), read from node_modules at build time.
const phosphor: Record<string, string> = {
  heart: 'heart', arrow: 'arrow-right', menu: 'list', close: 'x', share: 'share-network',
  copy: 'copy', pin: 'map-pin', calendar: 'calendar-dots', users: 'users-three', gift: 'gift',
  book: 'book-open', shirt: 't-shirt', basket: 'basket', hand: 'hand-heart', megaphone: 'megaphone',
  handshake: 'handshake', globe: 'globe-hemisphere-west', shield: 'shield-check', camera: 'camera',
  card: 'credit-card', phone: 'device-mobile', sparkle: 'sparkle', chevL: 'caret-left',
  chevR: 'caret-right', check: 'check', plus: 'plus',
};

// Brand logos (WhatsApp, socials) stay as their own marks.
const fill: Record<string, string> = {
  whatsapp:
    '<path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.36A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.1.8.83-3-.2-.31A8.2 8.2 0 1 1 12.04 20.1Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.31c-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.58.25 1.04.4 1.4.52.59.18 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"/>',
  instagram:
    '<path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM21.5 8c-.1-1.5-.4-2.8-1.5-3.9C18.9 3 17.6 2.6 16.1 2.6 14.6 2.5 9.4 2.5 7.9 2.6 6.4 2.6 5.1 3 4 4.1 2.9 5.2 2.6 6.5 2.5 8c-.1 1.5-.1 6.6 0 8.1.1 1.5.4 2.8 1.5 3.9 1.1 1.1 2.4 1.4 3.9 1.5 1.5.1 6.7.1 8.2 0 1.5-.1 2.8-.4 3.9-1.5 1.1-1.1 1.4-2.4 1.5-3.9.1-1.5.1-6.6 0-8.1Z"/>',
  facebook:
    '<path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  tiktok:
    '<path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-1.8-2.5V9.8a5.7 5.7 0 1 0 4.9 5.6V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4s-1.9.1-3.2-1.6Z"/>',
  x: '<path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.4L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.3 4.7H5.5l11.2 14.5Z"/>',
};

let body = '';
let viewBox = '0 0 24 24';
if (name in fill) {
  body = fill[name];
} else if (name in phosphor) {
  const file = join(process.cwd(), 'node_modules/@phosphor-icons/core/assets/fill', `${phosphor[name]}-fill.svg`);
  const svg = readFileSync(file, 'utf-8');
  body = svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
  viewBox = '0 0 256 256';
}
---

<svg class={cls} width={size} height={size} viewBox={viewBox} aria-hidden="true" fill="currentColor" set:html={body} />
