  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={body}
/>
