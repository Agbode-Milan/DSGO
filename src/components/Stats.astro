---
import { stats } from '../data/site';
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<div class:list={['stats', { 'stats--dark': dark }]}>
  {
    stats.map((s, i) => (
      <div class="stat reveal" style={`--d:${i}`}>
        <span class="stat__num">
          <span data-count={s.value}>{s.value}</span>
          {s.suffix}
        </span>
        <span class="stat__label">{s.label}</span>
      </div>
    ))
  }
  <div class="stat reveal" style="--d:2">
    <span class="stat__num stat__num--word">Meals, gifts <br />&amp; health checks</span>
    <span class="stat__label">At every Child of Hope Funfest</span>
  </div>
  <div class="stat reveal" style="--d:3">
    <span class="stat__num stat__num--word">1,000 <br />children</span>
    <span class="stat__label">Our goal for 26 December 2026</span>
  </div>
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat {
    background: var(--paper);
    padding: clamp(1.3rem, 3vw, 2.2rem);
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .stat__num {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.6rem, 1.8rem + 3.5vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--orange);
  }
  .stat__num--word {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--navy);
  }
  .stat__label {
    font-weight: 650;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  @media (min-width: 860px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats--dark {
    background: rgba(255, 255, 255, 0.14);
  }
  .stats--dark .stat {
    background: var(--navy);
  }
  .stats--dark .stat__num {
    color: var(--sun);
  }
  .stats--dark .stat__num--word {
    color: #fff;
  }
  .stats--dark .stat__label {
    color: #c9c8e4;
  }
</style>
