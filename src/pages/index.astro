---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import GiveWidget from '../components/GiveWidget.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import Programmes from '../components/Programmes.astro';
import { site, campaign } from '../data/site';

const slides = [
  { slug: 'tiedye-group-2', pos: '55% 40%' },
  { slug: 'funfest-crowd-cheering', pos: '50% 40%' },
  { slug: 'facepaint-boys', pos: '50% 35%' },
  { slug: 'drawings-group', pos: '50% 55%' },
  { slug: 'funfest-dancing-kids', pos: '50% 40%' },
];

const ways = [
  { icon: 'heart', title: 'Sponsor a child', text: 'GH₵50 covers one child’s meal, Bible-story book and a full day of play.', href: '/donate#give' },
  { icon: 'basket', title: 'Snacks & drinks', text: 'Bottled water, drinks and snacks for a thousand hungry, happy children.', href: '/donate#items' },
  { icon: 'shirt', title: 'Clothing', text: 'New or gently used clothes for the children and their mothers.', href: '/donate#items' },
  { icon: 'book', title: 'Stationery', text: 'Exercise books, pens and learning materials for the school year ahead.', href: '/donate#items' },
  { icon: 'hand', title: 'Your time', text: 'Serve food, run games, pray with families or help us set up on the day.', href: '/get-involved#volunteer' },
];

const stories = [
  {
    slug: 'mother-baby-water',
    tag: 'Mothers',
    title: 'A day off her feet',
    text: 'Many mothers we meet carry loads through the market with a baby on their back. At the Funfest they eat, rest, get a free health check and watch their children play.',
    pos: '50% 25%',
  },
  {
    slug: 'boy-red-eating',
    tag: 'Children',
    title: 'Room to just be a child',
    text: 'A hot plate of food, a bouncy castle, a book of Bible stories to colour in. Small things that tell a child: you matter to God, and you matter to us.',
    pos: '50% 50%',
  },
  {
    slug: 'volunteer-dance-kids',
    tag: 'Volunteers',
    title: 'Love with its sleeves rolled up',
    text: 'None of this happens alone. Volunteers, churches and partners give their time and gifts freely, because that is what love does.',
    pos: '50% 40%',
  },
];
---

<Layout
  title="Home"
  description="Divine Selasi Global Outreach brings the love of Jesus to children and mothers in the Kayayei community of Agbogbloshie, Accra. GH₵50 sponsors one child at the Child of Hope Funfest on 26 December."
  overHero
>
  <!-- ── Hero ───────────────────────────── -->
  <section class="hero">
    <div class="hero__slides" data-slides>
      {
        slides.map((s, i) => (
          <div class:list={['slide', { on: i === 0 }]}>
            <Photo slug={s.slug} lightbox={false} eager={i === 0} sizes="100vw" widths={[640, 960, 1400, 1800]} position={s.pos} alt="" />
          </div>
        ))
      }
    </div>
    <div class="wrap hero__in">
      <a href="/donate#give" class="hero__count reveal" data-countdown={`${site.outreachMonth}-${site.outreachDay}`}>
        <span class="hero__dot"></span>
        <b data-days>—</b> <span data-days-label>days to go</span><span class="hero__count-x">· Child of Hope Funfest</span>
      </a>
      <h1 class="reveal" style="--d:1">Every child deserves to know they are <em class="scribble">loved.</em></h1>
      <p class="hero__sub reveal" style="--d:2">
        This 26 December we’re welcoming 1,000 children from the Kayayei community of Agbogbloshie to a day of food, play, health care and the love of Jesus.
      </p>
      <div class="hero__btns reveal" style="--d:3">
        <a href="/donate#give" class="btn btn--lg"><Icon name="heart" /> Sponsor a child · GH₵50</a>
        <a href="/our-story" class="btn btn--ghost">Our story</a>
      </div>
    </div>
    <a href="#why" class="hero__scroll" aria-label="Scroll to read more"><span></span></a>
  </section>

  <!-- ── Why ───────────────────────────── -->
  <section class="section why" id="why">
    <div class="wrap why__grid">
      <div class="why__photos">
        <Photo slug="mother-baby-water" class="why__p1 reveal" sizes="(max-width: 860px) 70vw, 30vw" position="50% 25%" />
        <Photo slug="boy-smiling-plate" class="why__p2 reveal" style="--d:2" sizes="(max-width: 860px) 45vw, 20vw" />
        <span class="why__badge reveal" style="--d:3"><Icon name="pin" size={18} /> Agbogbloshie, Accra</span>
      </div>
      <div class="why__copy">
        <p class="eyebrow reveal">Who we serve</p>
        <h2 class="reveal" style="--d:1">She carries the market on her head. <span class="hl">Her child deserves a day to just be a child.</span></h2>
        <p class="reveal" style="--d:2">
          The Kayayei (head porters) of Agbogbloshie are mostly young women and girls who came to Accra hoping for a better life. They carry heavy loads from dawn to dusk for very little pay, many with a baby on their back and nowhere safe to sleep at night.
        </p>
        <p class="reveal" style="--d:3">
          We exist to stand beside them. We bring food, health care and practical help, and we bring it in the name of Jesus, so that every mother and child we meet knows they are seen, valued and deeply loved.
        </p>
        <a href="/our-story" class="link-arrow reveal" style="--d:4">Read our story</a>
      </div>
    </div>
  </section>

  <!-- ── The ask ───────────────────────── -->
  <section class="section ask" id="give">
    <div class="wrap ask__grid">
      <div class="ask__copy">
        <p class="eyebrow reveal">Child of Hope Funfest · 26 Dec {campaign.year}</p>
        <h2 class="reveal" style="--d:1">1,000 children. One day of <span class="scribble">pure joy.</span></h2>
        <p class="reveal" style="--d:2">
          The day after Christmas, we turn Agbogbloshie into a funfair: hot meals, bouncy castles, horse rides, music, free health checks, and a Bible-story colouring book made just for them. Every GH₵50 brings one more child through the gate.
        </p>
        <ul class="ask__list">
          <li class="reveal" style="--d:3"><Icon name="check" size={20} /> GH₵50 covers one child’s whole day</li>
          <li class="reveal" style="--d:4"><Icon name="target" size={20} /> Our goal: GH₵{campaign.goal.toLocaleString()} for {campaign.children.toLocaleString()} children</li>
          <li class="reveal" style="--d:5"><Icon name="camera" size={20} /> Photos and a thank-you after the day</li>
        </ul>
      </div>
      <div class="reveal" style="--d:2">
        <GiveWidget id="home-give" />
      </div>
    </div>
  </section>

  <!-- ── Impact ────────────────────────── -->
  <section class="section impact">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow reveal">Since 2022</p>
          <h2 class="reveal" style="--d:1">Every number is someone we’ve met.</h2>
        </div>
        <p class="reveal" style="--d:2">We keep going back to the same community, year after year. God has been faithful, and this year we’re believing for more children than ever.</p>
      </div>
      <Stats />
    </div>
  </section>

  <!-- ── Mosaic ────────────────────────── -->
  <section class="section mosaic-sec">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow reveal">At the Funfest</p>
          <h2 class="reveal" style="--d:1">This is what hope looks like.</h2>
        </div>
        <a href="/gallery" class="btn btn--navy reveal" style="--d:2">See all photos <Icon name="arrow" /></a>
      </div>
      <div class="mosaic">
        <Photo slug="outreach-distribution-crowd" class="m1 reveal" sizes="(max-width: 760px) 100vw, 50vw" />
        <Photo slug="girls-peace-eating" class="m2 reveal" style="--d:1" sizes="(max-width: 760px) 50vw, 25vw" />
        <Photo slug="food-line-girls" class="m3 reveal" style="--d:2" sizes="(max-width: 760px) 50vw, 25vw" />
        <Photo slug="face-painting" class="m4 reveal" style="--d:1" sizes="(max-width: 760px) 50vw, 25vw" />
        <Photo slug="cloth-gifts-mothers" class="m5 reveal" style="--d:2" sizes="(max-width: 760px) 50vw, 25vw" />
        <Photo slug="funfest-team-group-1" class="m6 reveal" style="--d:3" sizes="(max-width: 760px) 100vw, 50vw" />
      </div>
    </div>
  </section>

  <!-- ── Stories ───────────────────────── -->
  <section class="section stories">
    <div class="wrap">
      <p class="eyebrow reveal">Beyond the numbers</p>
      <h2 class="reveal" style="--d:1">Seen. Valued. Deeply loved.</h2>
      <div class="stories__row">
        {
          stories.map((s, i) => (
            <article class="story reveal" style={`--d:${i}`}>
              <Photo slug={s.slug} sizes="(max-width: 760px) 85vw, 33vw" position={s.pos} />
              <div class="story__body">
                <span class="story__tag">{s.tag}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
      <a href="/our-impact" class="link-arrow reveal">Read more stories</a>
    </div>
  </section>

  <Programmes />

  <!-- ── Ways to give ──────────────────── -->
  <section class="section ways">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow reveal">More than money</p>
          <h2 class="reveal" style="--d:1">Every gift finds a home.</h2>
        </div>
        <p class="reveal" style="--d:2">Money, items or time: everything below goes straight to the children and mothers on 26 December.</p>
      </div>
      <div class="ways__row">
        {
          ways.map((w, i) => (
            <a href={w.href} class="way reveal" style={`--d:${i}`}>
              <span class="way__n">0{i + 1}</span>
              <span class="way__icon"><Icon name={w.icon} size={28} /></span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              <span class="way__go"><Icon name="arrow" size={20} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Join ──────────────────────────── -->
  <section class="section join">
    <div class="wrap join__grid">
      <div>
        <p class="eyebrow reveal">Join us</p>
        <h2 class="reveal" style="--d:1">There’s a place for you here.</h2>
        <p class="lede reveal" style="--d:2">Give, serve, partner or pray. However you join in, you become part of what God is doing in Agbogbloshie.</p>
      </div>
      <div class="join__list">
        <a href="/donate#give" class="joinc reveal"><Icon name="heart" size={26} /><span><b>Give</b>Sponsor a child, or donate food, clothing and stationery.</span></a>
        <a href="/get-involved#volunteer" class="joinc reveal" style="--d:1"><Icon name="hand" size={26} /><span><b>Volunteer</b>Pack gifts beforehand or serve with us on the day.</span></a>
        <a href="/get-involved#partner" class="joinc reveal" style="--d:2"><Icon name="handshake" size={26} /><span><b>Partner</b>Churches, businesses and schools: let’s do more together.</span></a>
        <button type="button" class="joinc reveal" style="--d:3" data-share><Icon name="megaphone" size={26} /><span><b>Share</b>Send this to one friend who would want to help.</span></button>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
    overflow: hidden;
    padding-bottom: clamp(5rem, 10vh, 7rem);
  }
  .hero__slides,
  .slide {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .slide {
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .slide.on {
    opacity: 1;
  }
  .slide :global(.ph) {
    height: 100%;
    border-radius: 0;
  }
  .slide.on :global(img) {
    animation: kb 12s ease-out forwards;
  }
  @keyframes kb {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(23, 24, 58, 0.6);
  }
  .hero__in {
    padding-top: 110px;
  }
  .hero h1 {
    max-width: 12ch;
    margin-bottom: 0.35em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }
  .hero .scribble::after {
    background: var(--orange);
    height: 0.2em;
    bottom: 0.06em;
  }
  .hero__sub {
    max-width: 36ch;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    opacity: 0.94;
    margin-bottom: 1.8rem;
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn--lg {
    min-height: 60px;
    font-size: 1.1rem;
    padding-inline: 1.8em;
  }
  .hero__count {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    flex-wrap: wrap;
    padding: 0.5rem 1rem 0.5rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 1.3rem;
  }
  .hero__count b {
    color: var(--sun);
    font-family: var(--display);
    font-size: 1.1rem;
  }
  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 0 rgba(255, 194, 61, 0.7);
    animation: ping 2s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 10px rgba(255, 194, 61, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 194, 61, 0);
    }
  }
  .hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 20px;
  }
  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    background: #fff;
    border-radius: 4px;
    animation: wheel 1.8s infinite;
  }
  @keyframes wheel {
    to {
      transform: translateY(14px);
      opacity: 0;
    }
  }
  @media (max-width: 520px) {
    .hero__btns .btn {
      width: 100%;
    }
    .hero__scroll {
      display: none;
    }
    .hero {
      padding-bottom: 2.5rem;
    }
  }

  /* Why */
  .why__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .why__photos {
    position: relative;
    padding: 0 18% 14% 0;
  }
  .why__photos :global(.why__p1) {
    aspect-ratio: 4 / 5;
    border-radius: 30px;
  }
  .why__photos :global(.why__p2) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 1;
    border: 6px solid var(--cream);
    border-radius: 26px;
    box-shadow: var(--shadow);
  }
  .why__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #fff;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: var(--shadow);
  }
  .why__badge :global(svg) {
    color: var(--orange);
  }
  .why__copy p:not(.eyebrow) {
    color: var(--ink-soft);
    max-width: 52ch;
  }
  @media (min-width: 860px) {
    .why__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
  }

  /* Ask */
  .ask {
    background: var(--navy);
    color: #fff;
    border-radius: clamp(28px, 5vw, 56px);
    margin-inline: clamp(8px, 1.5vw, 20px);
    position: relative;
    overflow: hidden;
  }
  .ask .eyebrow {
    color: var(--sun);
  }
  .ask__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .ask__copy > p {
    color: #d6d5ec;
    max-width: 46ch;
  }
  .ask .scribble::after {
    background: var(--orange);
    height: 0.18em;
  }
  .ask__list {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  .ask__list li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-weight: 650;
  }
  .ask__list :global(svg) {
    flex: none;
    color: var(--ink);
    background: var(--sun);
    border-radius: 50%;
    padding: 4px;
    width: 28px;
    height: 28px;
  }
  @media (min-width: 960px) {
    .ask__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  /* Shared head row */
  .head-row {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head-row > p {
    color: var(--ink-soft);
    max-width: 42ch;
    margin: 0;
  }
  .head-row h2 {
    margin: 0;
  }
  @media (min-width: 860px) {
    .head-row {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
      gap: 3rem;
    }
    .head-row > .btn {
      justify-self: end;
    }
  }

  /* Mosaic */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(150px, 26vw, 230px);
    gap: 10px;
  }
  .mosaic :global(.m1) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .mosaic :global(.m6) {
    grid-column: span 2;
  }
  @media (min-width: 760px) {
    .mosaic {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 230px;
      gap: 14px;
    }
    .mosaic :global(.m2) {
      grid-row: span 2;
    }
    .mosaic :global(.m6) {
      grid-column: span 3;
    }
  }

  /* Stories */
  .stories {
    background: var(--blush);
  }
  .stories__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 380px);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 2rem calc(-1 * var(--gutter)) 2rem;
    padding: 0 var(--gutter) 10px;
    scrollbar-width: none;
  }
  .stories__row::-webkit-scrollbar {
    display: none;
  }
  .story {
    scroll-snap-align: start;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .story :global(.ph) {
    aspect-ratio: 4 / 3.2;
    border-radius: 0;
  }
  .story__body {
    padding: 1.4rem 1.4rem 1.6rem;
  }
  .story__body p {
    color: var(--ink-soft);
    margin: 0;
  }
  .story__tag {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange-deep);
    margin-bottom: 0.6rem;
  }
  @media (min-width: 900px) {
    .stories__row {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }
  }

  /* Ways */
  .ways__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72%, 270px);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(-1 * var(--gutter));
    padding: 6px var(--gutter) 14px;
    scrollbar-width: none;
  }
  .ways__row::-webkit-scrollbar {
    display: none;
  }
  .way {
    position: relative;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1.5px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.3s;
  }
  .way:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .way__n {
    position: absolute;
    right: 1.2rem;
    top: 1.1rem;
    font-family: var(--display);
    font-weight: 800;
    color: var(--line);
    font-size: 1.6rem;
  }
  .way__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--sun-soft);
    color: var(--orange-deep);
    margin-bottom: 1.2rem;
  }
  .way:nth-child(2n) .way__icon {
    background: #e4f2ea;
    color: var(--leaf);
  }
  .way:nth-child(3n) .way__icon {
    background: #e6e7f7;
    color: var(--navy);
  }
  .way h3 {
    margin-bottom: 0.4em;
  }
  .way p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    margin-bottom: 1.2rem;
  }
  .way__go {
    margin-top: auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    transition: transform 0.3s var(--ease);
  }
  .way:hover .way__go {
    transform: translateX(4px);
  }
  @media (min-width: 1000px) {
    .ways__row {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, 1fr);
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }

  /* Join */
  .join {
    padding-top: 0;
  }
  .join__grid {
    display: grid;
    gap: 2rem;
  }
  .join__list {
    display: grid;
    gap: 10px;
  }
  .joinc {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius);
    background: #fff;
