---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, wa } from '../data/site';

const quick = [
  { label: 'Outreach day', msg: 'Hi DSGO! I’d love to volunteer on outreach day (26th December).' },
  { label: 'Sorting & packing', msg: 'Hi DSGO! I’d like to help with sorting and packing donations.' },
  { label: 'Offer a skill', msg: 'Hi DSGO! I’d like to offer a skill (design, admin, photography, etc.).' },
  { label: 'Year-round', msg: 'Hi DSGO! I’d like to help year-round, not just in December.' },
];

const firstSocial = Object.values(site.socials).find(Boolean);
---

<Layout
  title="Get Involved"
  description="Volunteer, partner or spread the word. Join Divine Selasi Global Outreach and help us show up for Kayayes and young mothers in Accra."
  ogPhoto="funfest-team-group-1"
>
  <PageHero eyebrow="Join us" slug="funfest-team-member-dance" position="50% 30%">
    <Fragment slot="title">You can be part of <span class="hl">the change.</span></Fragment>
    <p>DSGO runs on people who show up, as volunteers, partners and champions. No special skills needed, just a big heart.</p>
    <div class="jumps">
      <a href="#volunteer" class="chip"><Icon name="hand" size={18} /> Volunteer</a>
      <a href="#partner" class="chip"><Icon name="handshake" size={18} /> Partner</a>
      <a href="#share" class="chip"><Icon name="megaphone" size={18} /> Spread the word</a>
    </div>
  </PageHero>

  <!-- Volunteer -->
  <section class="section vol" id="volunteer">
    <div class="wrap vol__grid">
      <div class="vol__copy">
        <p class="eyebrow reveal">01 · Volunteer</p>
        <h2 class="reveal" style="--d:1">Spend a day you’ll never forget.</h2>
        <p class="reveal" style="--d:2">
          Volunteers do everything from sorting and packing donations to travelling with us to Agbogbloshie on 26th December. All you need is time, energy and a willingness to show up.
        </p>
        <Photo slug="funfest-team-group-2" class="vol__photo reveal" style="--d:3" sizes="(max-width: 960px) 100vw, 45vw" />
      </div>

      <div class="formcard reveal" style="--d:1">
        <h3>Count me in</h3>
        <p class="formcard__sub">Tap one to message us right away:</p>
        <div class="chips">
          {quick.map((q) => <a class="chip" href={wa(q.msg)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> {q.label}</a>)}
        </div>
        <div class="or"><span>or tell us about yourself</span></div>
        <form data-wa-form="Hi DSGO! I’d like to volunteer 🙌">
          <div class="field">
            <label for="v-name">Full name</label>
            <input id="v-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="v-contact">Phone or email</label>
            <input id="v-contact" name="contact" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="v-how">How would you like to help?</label>
            <select id="v-how" name="how" required>
              <option value="">Choose one</option>
              <option>Outreach day (26 Dec)</option>
              <option>Sorting &amp; packing</option>
              <option>Skills-based (design, admin, etc.)</option>
              <option>Ongoing / year-round</option>
            </select>
          </div>
          <div class="field">
            <label for="v-notes">Anything else we should know?</label>
            <textarea id="v-notes" name="notes"></textarea>
          </div>
          <button class="btn btn--wa btn--block" type="submit"><Icon name="whatsapp" /> Send on WhatsApp</button>
          <p class="form-note">This opens WhatsApp with your details filled in, so you just hit send.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Partner -->
  <section class="section partner" id="partner">
    <div class="wrap partner__card">
      <Photo slug="donation-boxes-medicine" class="partner__photo" sizes="(max-width: 860px) 100vw, 45vw" />
      <div class="partner__copy">
        <p class="eyebrow reveal">02 · Partner</p>
        <h2 class="reveal" style="--d:1">Let’s do more, together.</h2>
        <p class="reveal" style="--d:2">
          Businesses, churches, schools and organisations can partner with DSGO through in-kind donations, corporate sponsorship, or by hosting a collection drive for the December outreach.
        </p>
        <p class="reveal" style="--d:3">We’ll work with your team to agree what’s needed, when, and how your partnership will be recognised.</p>
        <a href={wa('Hi DSGO! I’d like to talk about a partnership.')} target="_blank" rel="noopener" class="btn btn--sun reveal" style="--d:4">
          <Icon name="handshake" /> Start a conversation
        </a>
      </div>
    </div>
  </section>

  <!-- Share -->
  <section class="section share" id="share">
    <div class="wrap">
      <p class="eyebrow reveal">03 · Spread the word</p>
      <h2 class="reveal" style="--d:1">Can’t give right now? Your voice still counts.</h2>
      <p class="lede reveal" style="--d:2">Sharing DSGO costs nothing, and it works. Most of our volunteers found us through a friend.</p>
      <div class="share__grid">
        <button type="button" class="sc sc--hot reveal" data-share>
          <Icon name="share" size={28} />
          <b>Share this site</b>
          <span>Send DSGO to one person who’d care.</span>
        </button>
        <a class="sc reveal" style="--d:1" href={firstSocial || wa('Hi DSGO! Where can I follow you online?')} target="_blank" rel="noopener">
          <Icon name="instagram" size={28} />
          <b>Follow along</b>
          <span>Outreach updates, stories and photos.</span>
        </a>
        <div class="sc reveal" style="--d:2">
          <Icon name="camera" size={28} />
          <b>Tag us</b>
          <span>Donated or volunteered? Post it and tag DSGO so others find us too.</span>
        </div>
        <a class="sc reveal" style="--d:3" href="/our-story">
          <Icon name="megaphone" size={28} />
          <b>Talk about it</b>
          <span>Mention DSGO at church, work or your community group.</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand slug="funfest-team-crowd-cheer" title="Ready to help?" text="Whether it’s a gift, a Saturday or a share, it all lands somewhere real." />
</Layout>

<style>
  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .jumps :global(svg) {
    color: var(--orange);
  }
  .vol {
    background: var(--blush);
  }
  .vol__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .vol__copy p:not(.eyebrow) {
    color: var(--ink-soft);
    max-width: 48ch;
  }
  .vol__copy :global(.vol__photo) {
    aspect-ratio: 16 / 10;
    margin-top: 1.5rem;
  }
  .formcard {
    background: #fff;
    border-radius: 28px;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    box-shadow: var(--shadow-lg);
  }
  .formcard h3 {
    font-size: 1.8rem;
    margin-bottom: 0.3rem;
  }
  .formcard__sub {
    color: var(--ink-soft);
    margin-bottom: 0.8rem;
  }
  .formcard .chip :global(svg) {
    color: #1fa855;
  }
  .or {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.6rem 0 1.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .or::before,
  .or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  @media (min-width: 960px) {
    .vol__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .formcard {
      position: sticky;
      top: 100px;
    }
  }

  .partner__card {
    display: grid;
    background: var(--navy);
    color: #fff;
    border-radius: clamp(26px, 4vw, 44px);
    overflow: hidden;
  }
  .partner__card :global(.partner__photo) {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .partner__copy {
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .partner .eyebrow {
    color: var(--sun);
  }
  .partner__copy p:not(.eyebrow) {
    color: #d6d5ec;
  }
  @media (min-width: 860px) {
    .partner__card {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    .partner__card :global(.partner__photo) {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .share {
    padding-top: 0;
  }
  .share__grid {
    display: grid;
    gap: 12px;
    margin-top: 2rem;
  }
  .sc {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: #fff;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    text-decoration: none;
    box-shadow: 0 1px 0 var(--line);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  a.sc:hover,
  button.sc:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .sc :global(svg) {
    color: var(--orange);
    margin-bottom: 0.6rem;
  }
  .sc b {
    font-family: var(--display);
    font-size: 1.3rem;
  }
  .sc span {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .sc--hot {
    background: var(--orange);
    color: #fff;
  }
  .sc--hot :global(svg),
  .sc--hot span {
    color: #fff;
  }
  @media (min-width: 640px) {
    .share__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .share__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
