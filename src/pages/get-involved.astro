---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, wa } from '../data/site';

const quick = [
  { label: 'Funfest day (26 Dec)', msg: 'Hi DSGO! I’d love to volunteer at the Child of Hope Funfest on 26 December.' },
  { label: 'Packing & set-up', msg: 'Hi DSGO! I’d like to help pack gifts and set up for the Funfest.' },
  { label: 'Offer a skill', msg: 'Hi DSGO! I’d like to offer a skill (health care, photography, design, music, etc.).' },
  { label: 'Year-round', msg: 'Hi DSGO! I’d like to serve year-round, including The WinePress and The Seekers Tent.' },
];

const firstSocial = Object.values(site.socials).find(Boolean);
---

<Layout
  title="Get Involved"
  description="Volunteer at the Child of Hope Funfest, partner with Divine Selasi Global Outreach, or pray and share. There’s a place for you in what God is doing in Agbogbloshie."
  ogPhoto="funfest-team-group-1"
>
  <PageHero eyebrow="Join us" slug="funfest-team-member-dance" position="50% 30%">
    <Fragment slot="title">There’s room for you <span class="hl">in this story.</span></Fragment>
    <p>The Funfest runs on volunteers, partners and people who pray. No special skills needed, just a willing heart.</p>
    <div class="jumps">
      <a href="#volunteer" class="chip"><Icon name="hand" size={18} /> Volunteer</a>
      <a href="#partner" class="chip"><Icon name="handshake" size={18} /> Partner</a>
      <a href="#share" class="chip"><Icon name="pray" size={18} /> Pray &amp; share</a>
    </div>
  </PageHero>

  <!-- Volunteer -->
  <section class="section vol" id="volunteer">
    <div class="wrap vol__grid">
      <div class="vol__copy">
        <p class="eyebrow reveal">01 · Volunteer</p>
        <h2 class="reveal" style="--d:1">Spend 26 December where it really counts.</h2>
        <p class="reveal" style="--d:2">
          Volunteers serve food, run games, help with health screenings, take photos, pray with families and pack gifts in the weeks before. Bring your energy and your love for people. We’ll find you a place.
        </p>
        <Photo slug="funfest-team-group-2" class="vol__photo reveal" style="--d:3" sizes="(max-width: 960px) 100vw, 45vw" />
      </div>

      <div class="formcard reveal" style="--d:1">
        <h3>Count me in</h3>
        <p class="formcard__sub">Tap one to message us right away:</p>
        <div class="chips">
          {quick.map((q) => <a class="chip" href={wa(q.msg)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> {q.label}</a>)}
        </div>
        <div class="or"><span>or tell us about yourself</span></div>
        <form data-wa-form="Hi DSGO! I’d like to volunteer 🙌">
          <div class="field">
            <label for="v-name">Full name</label>
            <input id="v-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="v-contact">Phone or email</label>
            <input id="v-contact" name="contact" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="v-how">How would you like to help?</label>
            <select id="v-how" name="how" required>
              <option value="">Choose one</option>
              <option>Funfest day (26 Dec)</option>
              <option>Packing &amp; set-up</option>
              <option>Health screenings</option>
              <option>Skills-based (photography, design, music, etc.)</option>
              <option>Ongoing / year-round</option>
            </select>
          </div>
          <div class="field">
            <label for="v-notes">Anything else we should know?</label>
            <textarea id="v-notes" name="notes"></textarea>
          </div>
          <button class="btn btn--wa btn--block" type="submit"><Icon name="whatsapp" /> Send on WhatsApp</button>
          <p class="form-note">This opens WhatsApp with your details filled in, so you just hit send.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Partner -->
  <section class="section partner" id="partner">
    <div class="wrap partner__card">
      <Photo slug="volunteer-clothes" class="partner__photo" sizes="(max-width: 860px) 100vw, 45vw" />
      <div class="partner__copy">
        <p class="eyebrow reveal">02 · Partner</p>
        <h2 class="reveal" style="--d:1">Let’s do more, together.</h2>
        <p class="reveal" style="--d:2">
          Churches, businesses, schools and like-minded organisations can partner with us through sponsorship, in-kind gifts or a collection drive for the Child of Hope Funfest. Collaboration is one of our core values, and we’d love to work with you.
        </p>
        <p class="reveal" style="--d:3">We’ll agree together what’s needed, when, and how your support will be recognised.</p>
        <div class="partner__btns reveal" style="--d:4">
          <a href={wa('Hi DSGO! I’d like to talk about a partnership.')} target="_blank" rel="noopener" class="btn btn--sun">
            <Icon name="handshake" /> Start a conversation
          </a>
          <a href={`mailto:${site.email}?subject=Partnership%20with%20DSGO`} class="btn btn--ghost"><Icon name="mail" /> Email us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Share -->
  <section class="section share" id="share">
    <div class="wrap">
      <p class="eyebrow reveal">03 · Pray &amp; share</p>
      <h2 class="reveal" style="--d:1">Can’t give right now? You can still help.</h2>
      <p class="lede reveal" style="--d:2">Prayer and a simple share cost nothing, and both make a real difference. Many of our volunteers found us through a friend.</p>
      <div class="share__grid">
        <div class="sc sc--hot reveal">
          <Icon name="pray" size={28} />
          <b>Pray with us</b>
          <span>For the children, their mothers and our team as we prepare for 26 December.</span>
        </div>
        <button type="button" class="sc reveal" style="--d:1" data-share>
          <Icon name="share" size={28} />
          <b>Share this site</b>
          <span>Send it to one person who would want to help.</span>
        </button>
        <a class="sc reveal" style="--d:2" href={firstSocial || wa('Hi DSGO! Where can I follow you online?')} target="_blank" rel="noopener">
          <Icon name="instagram" size={28} />
          <b>Follow along</b>
          <span>{site.instagramHandle} for Funfest updates, stories and photos.</span>
        </a>
        <a class="sc reveal" style="--d:3" href="/our-story">
          <Icon name="church" size={28} />
          <b>Tell your church</b>
          <span>Mention the Funfest at church, work or your fellowship group.</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand slug="funfest-team-crowd-cheer" title="Ready to help?" text="A gift, a day of your time, a prayer or a share: it all reaches a child in Agbogbloshie." />
</Layout>

<style>
  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .jumps :global(svg) {
    color: var(--orange);
  }
  .vol {
    background: var(--blush);
  }
  .vol__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .vol__grid > * {
    min-width: 0;
  }
  .vol__copy p:not(.eyebrow) {
    color: var(--ink-soft);
    max-width: 48ch;
  }
  .vol__copy :global(.vol__photo) {
    aspect-ratio: 16 / 10;
    margin-top: 1.5rem;
  }
  .formcard {
    background: #fff;
    border-radius: 28px;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    box-shadow: var(--shadow-lg);
  }
  .formcard h3 {
    font-size: 1.8rem;
    margin-bottom: 0.3rem;
  }
  .formcard__sub {
    color: var(--ink-soft);
    margin-bottom: 0.8rem;
  }
  .formcard .chip :global(svg) {
    color: #1fa855;
  }
  .or {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.6rem 0 1.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .or::before,
  .or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  @media (min-width: 960px) {
    .vol__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .formcard {
      position: sticky;
      top: 100px;
    }
  }

  .partner__card {
    display: grid;
    background: var(--navy);
    color: #fff;
    border-radius: clamp(26px, 4vw, 44px);
    overflow: hidden;
  }
  .partner__card :global(.partner__photo) {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .partner__copy {
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .partner .eyebrow {
    color: var(--sun);
  }
  .partner__copy p:not(.eyebrow) {
    color: #d6d5ec;
  }
  .partner__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .partner__btns .btn--ghost {
    color: #fff;
  }
  @media (min-width: 860px) {
    .partner__card {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    .partner__card :global(.partner__photo) {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .share {
    padding-top: 0;
  }
  .share__grid {
    display: grid;
    gap: 12px;
    margin-top: 2rem;
  }
  .sc {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: #fff;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    text-decoration: none;
    box-shadow: 0 1px 0 var(--line);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  a.sc:hover,
  button.sc:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .sc :global(svg) {
    color: var(--orange);
    margin-bottom: 0.6rem;
  }
  .sc b {
    font-family: var(--display);
    font-size: 1.3rem;
  }
  .sc span {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .sc--hot {
    background: var(--orange);
    color: #fff;
  }
  .sc--hot :global(svg),
  .sc--hot span {
    color: #fff;
  }
  @media (min-width: 640px) {
    .share__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .share__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
