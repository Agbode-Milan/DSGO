---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Programmes from '../components/Programmes.astro';
import { site, values } from '../data/site';

const steps = [
  {
    when: 'Before',
    title: 'Gather & prepare',
    text: 'For weeks beforehand, volunteers collect donations, pack gifts, pray over the day and print the Child of Hope Bible-story colouring books.',
    slug: 'volunteer-clothes',
  },
  {
    when: 'On the day',
    title: 'Throw a funfair',
    text: 'Hot meals, games, bouncy castles, horse rides, music, free health screenings and gifts, right in the heart of Agbogbloshie.',
    slug: 'drawings-bouncy',
  },
  {
    when: 'After',
    title: 'Keep hope going',
    text: 'We follow up with families, share what your gifts made possible, and work towards skills training that helps Kayayei mothers earn a better living.',
    slug: 'laughing-mother-volunteer',
  },
];
---

<Layout
  title="Our Story"
  description="Divine Selasi Global Outreach is a Christian non-profit founded in Ghana in 2022 to light up the world with the love of Jesus, through the Child of Hope Funfest, The WinePress and The Seekers Tent."
  ogPhoto="tiedye-group-3"
>
  <PageHero eyebrow="Who we are" slug="tiedye-group-3" position="50% 40%">
    <Fragment slot="title">Lighting up the world <span class="hl">with the love of Jesus.</span></Fragment>
    <p>Divine Selasi Global Outreach is a Christian non-profit founded in Ghana in {site.founded}. We exist to touch lives, spread love and bring hope to the people who need it most.</p>
  </PageHero>

  <!-- Mission -->
  <section class="section split">
    <div class="wrap split__grid">
      <div class="split__media reveal">
        <Photo slug="jeans-handover" sizes="(max-width: 860px) 100vw, 45vw" />
      </div>
      <div>
        <p class="eyebrow reveal">Our mission</p>
        <h2 class="reveal" style="--d:1">Love you can see. Hope you can hold.</h2>
        <p class="mission reveal" style="--d:2">
          To light up the world with the love of Jesus by giving everyone the opportunity to experience the salvation and transformation Christ gives.
          <cite>Inspired by Luke 4:18</cite>
        </p>
        <p class="reveal" style="--d:3">
          We do that two ways at once. We meet real, practical needs like food, health care and clothing, and we share the good news that every person is loved by God. One without the other would be only half the story.
        </p>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section serve">
    <div class="wrap">
      <div class="serve__card">
        <div class="serve__copy">
          <p class="eyebrow reveal">Who we serve</p>
          <h2 class="reveal" style="--d:1">The Kayayei of Agbogbloshie, and their children.</h2>
          <p class="reveal" style="--d:2">
            Kayayei are young women and girls, many from northern Ghana, who earn a living carrying goods on their heads through Accra’s busiest markets. Many are mothers, raising little ones through long, exhausting days, often with nowhere safe to sleep.
          </p>
          <p class="reveal" style="--d:3">
            Agbogbloshie is home to one of the largest Kayayei communities in the city, and it is our focus for now. We keep coming back to the same families, year after year, so the hope we bring has room to grow.
          </p>
        </div>
        <div class="serve__photos">
          <Photo slug="volunteer-dance-mothers" class="reveal" sizes="(max-width: 860px) 50vw, 22vw" position="50% 25%" />
          <Photo slug="girl-pointing-drink" class="reveal" style="--d:1" sizes="(max-width: 860px) 50vw, 22vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Vision -->
  <section class="section vision">
    <div class="wrap">
      <p class="eyebrow reveal">Our vision</p>
      <blockquote class="reveal" style="--d:1">
        Whole lives, <span class="scribble">made new.</span>
      </blockquote>
      <p class="vision__sub reveal" style="--d:2">
        We long to see lives changed across Ghana and around the world, through care that reaches every part of a person: spiritual, physical and emotional, for believers and unbelievers alike.
      </p>
      <p class="vision__ref reveal" style="--d:3">Isaiah 61:1–6</p>
    </div>
  </section>

  <Programmes eyebrow="What we do" title="One ministry, three expressions." text="Everything we do flows from the same place: a desire to see people meet Jesus and be made whole." />

  <!-- Why 26 Dec -->
  <section class="section why26">
    <div class="wrap">
      <div class="why26__head">
        <p class="eyebrow reveal">Child of Hope Funfest</p>
        <h2 class="reveal" style="--d:1">Why 26 December?</h2>
        <p class="lede reveal" style="--d:2">The day after Christmas, when most families are gathered around full tables, we take the celebration to the children who would otherwise miss it.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step reveal" style={`--d:${i}`}>
              <Photo slug={s.slug} sizes="(max-width: 860px) 100vw, 33vw" />
              <div class="step__body">
                <span class="step__when">
                  <b>{i + 1}</b> {s.when}
                </span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a href="/gallery" class="link-arrow reveal">See Funfest photos</a>
    </div>
  </section>

  <!-- Values -->
  <section class="section vals">
    <div class="wrap">
      <p class="eyebrow reveal">Our values</p>
      <h2 class="reveal" style="--d:1">What we stand on.</h2>
      <div class="vals__grid">
        {
          values.map((v, i) => (
            <div class="val reveal" style={`--d:${i % 4}`}>
              <span class="val__ic">
                <Icon name={v.icon} size={24} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section team">
    <div class="wrap team__grid">
      <div>
        <p class="eyebrow reveal">The people behind DSGO</p>
        <h2 class="reveal" style="--d:1">Ordinary people, serving an extraordinary God.</h2>
        <p class="reveal" style="--d:2">
          DSGO is run by a small team of organisers and volunteers who are there in person at every outreach: sorting donations, serving food, praying with families and learning the names of the people we serve.
        </p>
        <a href="/get-involved" class="btn reveal" style="--d:3">Join the team <Icon name="arrow" /></a>
      </div>
      <div class="team__photos">
        <Photo slug="funfest-team-group-1" class="t1 reveal" sizes="(max-width: 860px) 100vw, 50vw" />
        <Photo slug="team-dance-belong-jesus" class="reveal" style="--d:1" sizes="(max-width: 860px) 50vw, 25vw" />
        <Photo slug="funfest-team-pair" class="reveal" style="--d:2" sizes="(max-width: 860px) 50vw, 25vw" />
      </div>
    </div>
  </section>

  <CtaBand slug="funfest-team-crowd-cheer" title="Want to be part of this story?" text="Give, serve, partner or pray with us. There’s a seat at this table for you." />
</Layout>

<style>
  .split__grid,
  .team__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .split__media :global(.ph) {
    aspect-ratio: 5 / 4;
    border-radius: 30px;
  }
  .split p:not(.eyebrow),
  .team p:not(.eyebrow) {
    color: var(--ink-soft);
    max-width: 52ch;
  }
  @media (min-width: 860px) {
    .split__grid,
    .team__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .serve {
    padding-top: 0;
  }
  .serve__card {
    display: grid;
    gap: 2rem;
    background: var(--navy);
    color: #fff;
    border-radius: clamp(26px, 4vw, 44px);
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .serve .eyebrow {
    color: var(--sun);
  }
  .serve__copy p:not(.eyebrow) {
    color: #d6d5ec;
  }
  .serve__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .serve__photos :global(.ph) {
    aspect-ratio: 3 / 4;
  }
  .serve__photos :global(.ph:nth-child(2)) {
    margin-top: 2rem;
  }
  @media (min-width: 860px) {
    .serve__card {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .vision {
    text-align: center;
    padding-top: 0;
  }
  .vision .eyebrow {
    justify-content: center;
  }
  .vision blockquote {
    margin: 0 auto 1.5rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.4rem + 4.2vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .vision__sub {
    max-width: 52ch;
    margin-inline: auto;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }

  .why26 {
    background: var(--blush);
  }
  .why26__head {
    margin-bottom: 2.5rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 14px;
  }
  .step {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .step :global(.ph) {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }
  .step__body {
    padding: 1.4rem;
  }
  .step__body p {
    color: var(--ink-soft);
    margin: 0;
  }
  .step__when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange-deep);
    margin-bottom: 0.7rem;
  }
  .step__when b {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    letter-spacing: 0;
  }
  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .team__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .team__photos :global(.ph) {
    aspect-ratio: 1;
  }
  .team__photos :global(.t1) {
    grid-column: span 2;
    aspect-ratio: 16 / 10;
  }
  .mission {
    font-family: var(--display);
    font-weight: 650;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    color: var(--ink) !important;
    padding-left: 1.1rem;
    border-left: 4px solid var(--orange);
  }
  .mission cite {
    display: block;
    margin-top: 0.6rem;
    font: 600 0.85rem var(--body);
    font-style: normal;
    color: var(--orange-deep);
  }
  .vision__ref {
    margin-top: 1rem;
    font-weight: 700;
    color: var(--orange-deep);
  }

  .vals {
    background: var(--paper);
  }
  .vals__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 2rem;
  }
  .val {
    padding: 1.3rem;
    border-radius: var(--radius);
    background: var(--cream);
  }
  .val h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }
  .val p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .val__ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--sun-soft);
    color: var(--orange-deep);
    margin-bottom: 0.9rem;
  }
  @media (max-width: 350px) {
    .vals__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 900px) {
    .vals__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .val {
      padding: 1.6rem;
    }
  }
</style>
