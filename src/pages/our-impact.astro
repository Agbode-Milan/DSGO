---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import { campaign } from '../data/site';

const highlights = [
  { icon: 'health', title: 'Free health screenings', text: 'Basic health checks and care for children and their families.' },
  { icon: 'food', title: 'Hot Christmas meals & gifts', text: 'A proper festive meal, drinks, gifts and essential items to take home.' },
  { icon: 'party', title: 'A real funfair', text: 'Games, bouncy castles, horse rides, music and entertainment.' },
  { icon: 'bulb', title: 'Skills for mothers', text: 'Skills training and livelihood opportunities for Kayayei head porters.' },
];

const plan = [
  { icon: 'food', title: 'Lunch & refreshments', text: 'For every one of the 1,000 children taking part.' },
  { icon: 'music', title: 'Music, dance & games', text: 'Plus performances by the children themselves.' },
  { icon: 'bible', title: 'A book of their own', text: 'Each child takes home our Child of Hope Bible-story colouring book.' },
];

const stories = [
  {
    tag: 'Mothers',
    title: 'Standing with mothers',
    text: 'Many of the women we meet are raising children alone while carrying loads from dawn to dusk. At the Funfest they get a hot meal, a health check and a few hours where someone else looks after them for a change.',
    slugs: ['mother-baby-water', 'mother-child-crowd'],
    pos: '50% 25%',
  },
  {
    tag: 'Children',
    title: 'A childhood, celebrated',
    text: 'Children are at the heart of every Funfest. For one day there are no loads to carry, only food to share, games to win, songs to sing and stories of a God who knows them by name.',
    slugs: ['funfest-eating-8', 'funfest-dancing-kids'],
    pos: '50% 40%',
  },
  {
    tag: 'Volunteers',
    title: 'The body of Christ, at work',
    text: 'Every Funfest depends on people who choose to show up: volunteers, churches and partners who give their time and gifts freely. Their love is what makes the day possible.',
    slugs: ['funfest-team-crowd-cheer', 'outreach-table-service'],
    pos: '50% 40%',
  },
];
---

<Layout
  title="Our Impact"
  description="500+ people supported and 200+ families reached in Agbogbloshie, Accra since 2022. See what happens at the Child of Hope Funfest and our plan for 1,000 children in 2026."
  ogPhoto="funfest-crowd-cheering"
>
  <PageHero eyebrow="Our impact" slug="funfest-crowd-cheering">
    <Fragment slot="title">Every number <span class="hl">has a name.</span></Fragment>
    <p>Since 2022 we’ve kept going back to the same community in Agbogbloshie. Here is what God has done through people like you.</p>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <Stats />
      <p class="note reveal"><Icon name="sparkle" size={16} /> We update these after every Funfest, so they keep growing as more families are reached.</p>
    </div>
  </section>

  <!-- Every Christmas -->
  <section class="section hl4">
    <div class="wrap">
      <p class="eyebrow reveal">Every Christmas</p>
      <h2 class="reveal" style="--d:1">What happens at the Funfest.</h2>
      <div class="hl4__grid">
        {
          highlights.map((h, i) => (
            <div class="hcard reveal" style={`--d:${i}`}>
              <span class="hcard__ic">
                <Icon name={h.icon} size={26} />
              </span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section stories">
    <div class="wrap">
      <p class="eyebrow reveal">Beyond the numbers</p>
      <h2 class="reveal" style="--d:1">Stories, not statistics.</h2>
      <p class="lede reveal" style="--d:2">We share these stories with consent, and always with dignity, never pity.</p>

      <div class="srows">
        {
          stories.map((s, i) => (
            <article class:list={['srow', { flip: i % 2 === 1 }]}>
              <div class="srow__media">
                <Photo slug={s.slugs[0]} class="reveal" sizes="(max-width: 860px) 70vw, 30vw" position={s.pos} />
                <Photo slug={s.slugs[1]} class="reveal srow__small" style="--d:1" sizes="(max-width: 860px) 45vw, 18vw" />
              </div>
              <div class="srow__copy">
                <span class="tag reveal">{s.tag}</span>
                <h3 class="reveal" style="--d:1">{s.title}</h3>
                <p class="reveal" style="--d:2">{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 2026 plan -->
  <section class="section plan">
    <div class="wrap plan__grid">
      <div>
        <p class="eyebrow reveal">The {campaign.year} edition</p>
        <h2 class="reveal" style="--d:1">This year: <span class="hl">1,000 children.</span></h2>
        <p class="reveal" style="--d:2">
          Our biggest Funfest yet. We want to inspire hope and help children grow in every way by giving 1,000 children from the Kayayei community of Agbogbloshie a day that is educational, faith-filled and full of fun.
        </p>
        <a href="/donate#give" class="btn btn--sun reveal" style="--d:3"><Icon name="heart" /> Sponsor a child · GH₵{campaign.perChild}</a>
      </div>
      <ul class="plan__list">
        {
          plan.map((p, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <span class="plan__ic">
                <Icon name={p.icon} size={24} />
              </span>
              <span>
                <b>{p.title}</b>
                {p.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section see">
    <div class="wrap see__in">
      <div>
        <p class="eyebrow reveal">See it for yourself</p>
        <h2 class="reveal" style="--d:1">Photos from every Funfest.</h2>
      </div>
      <a href="/gallery" class="btn btn--navy reveal" style="--d:2"><Icon name="camera" /> Open the gallery</a>
    </div>
  </section>

  <CtaBand slug="children-eating" title="Help us reach 1,000 children this December." text="GH₵50 sends one child to the Funfest: a hot meal, a Bible-story book and a whole day of joy." />
</Layout>

<style>
  .note {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 1.2rem;
  }
  .note :global(svg) {
    color: var(--orange);
    flex: none;
  }
  .stories {
    background: var(--blush);
  }
  .srows {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    margin-top: 3rem;
  }
  .srow {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .srow__media {
    position: relative;
    padding: 0 16% 12% 0;
  }
  .srow__media > :global(.ph:first-child) {
    aspect-ratio: 4 / 3.6;
    border-radius: 28px;
  }
  .srow__media :global(.srow__small) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 1;
    border: 6px solid var(--blush);
    border-radius: 24px;
  }
  .srow__copy p {
    color: var(--ink-soft);
    max-width: 46ch;
    font-size: 1.08rem;
  }
  .srow__copy h3 {
    font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.6rem);
  }
  .tag {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--orange);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  @media (min-width: 860px) {
    .srow {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
    .srow.flip .srow__media {
      order: 2;
    }
  }
  .see__in {
    display: grid;
    gap: 1.5rem;
  }
  .see h2 {
    margin: 0;
  }
  @media (min-width: 860px) {
    .see__in {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .hl4 {
    padding-top: 0;
  }
  .hl4__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 2rem;
  }
  .hcard {
    background: #fff;
    border-radius: var(--radius);
    padding: 1.3rem;
    box-shadow: 0 1px 0 var(--line);
  }
  .hcard h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }
  .hcard p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .hcard__ic {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 16px;
    background: var(--sun-soft);
    color: var(--orange-deep);
    margin-bottom: 1rem;
  }
  @media (max-width: 350px) {
    .hl4__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 900px) {
    .hl4__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .hcard {
      padding: 1.7rem;
    }
  }

  .plan {
    background: var(--navy);
    color: #fff;
  }
  .plan .eyebrow {
    color: var(--sun);
  }
  .plan .hl {
    color: var(--sun);
  }
  .plan__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .plan__grid p:not(.eyebrow) {
    color: #d6d5ec;
    max-width: 46ch;
  }
  .plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .plan__list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.07);
  }
  .plan__list li > span:last-child {
    display: grid;
    color: #d6d5ec;
    font-size: 0.97rem;
  }
  .plan__list b {
    color: #fff;
    font-family: var(--display);
    font-size: 1.15rem;
  }
  .plan__ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--sun);
    color: var(--ink);
  }
  @media (min-width: 860px) {
    .plan__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
</style>
